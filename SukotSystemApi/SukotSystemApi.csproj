    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukotSystemCore\SukotSystemCore.csproj" />
    <ProjectReference Include="..\SukotSystemData\SukotSystemData.csproj" />
    <ProjectReference Include="..\SukotSystemService\SukotSystemService.csproj" />
