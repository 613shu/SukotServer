<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <!-- Lets NLog understand ASP.NET Core specific layout renderers (e.g. request info) if needed later -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
	  
  </extensions>

  <targets>
    <!--
      Main application log - everything Debug and up ends up here.
      The *actual* minimum level that reaches this point is still controlled by
      appsettings.json / appsettings.Development.json (Logging:LogLevel:Default),
      exactly like the plain ILogger did before NLog was plugged in.
      One file per day, via ${shortdate}.
    -->
    <target xsi:type="File" name="appFile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|CorrelationId=${scopeproperty:item=CorrelationId}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!--
      Dedicated file for Warning and Error only - "exactly the events we want to see later"
      (Part D): resource conflicts (409 / DbUpdateConcurrencyException) and unhandled exceptions.
    -->
    <target xsi:type="File" name="errorFile"
            fileName="${basedir}/logs/errors-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|CorrelationId=${scopeproperty:item=CorrelationId}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!-- Console output while developing in Visual Studio / dotnet run -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|CorrelationId=${scopeproperty:item=CorrelationId}|${message}" />
  </targets>

  <rules>
    <!-- Quiet down the very chatty built-in ASP.NET Core / EF Core "Information" noise (routing, SQL, etc.) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />

    <!-- Our own request/flow logs (Debug and Information) go to the main file + console -->
    <logger name="*" minlevel="Debug" writeTo="appFile,console" />

    <!-- Warning (handled conflicts) and Error (unhandled exceptions) also go to the dedicated errors file -->
    <logger name="*" minlevel="Warning" writeTo="errorFile" />
  </rules>
</nlog>
